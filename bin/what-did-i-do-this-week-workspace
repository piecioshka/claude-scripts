#!/usr/bin/env bash

SHOW_HELP=""
DIR_ARG=""
for arg in "$@"; do
  case "$arg" in
    -h | --help) SHOW_HELP=1 ;;
    --no-color) export NO_COLOR=1 ;;
    *) DIR_ARG="$arg" ;;
  esac
done

source "$(dirname "$0")/../shared/spinner.sh"
source "$(dirname "$0")/../shared/output.sh"

if [[ -n "$SHOW_HELP" ]]; then
  cat <<EOF
${BOLD}Usage:${RESET} $(basename "$0") [options] [directory]

Summarize this week's git activity across all repositories in a workspace.
For each subdirectory containing a .git folder, runs git log on the main
(or master) branch since last Monday, then asks Claude to summarize.

${BOLD}Arguments:${RESET}
  directory     Workspace directory to scan (default: current directory)

${BOLD}Options:${RESET}
  --no-color    Disable colored output (also: NO_COLOR=1)
  -h, --help    Show this help message
EOF
  exit 0
fi

WORKSPACE="${DIR_ARG:-$(pwd)}"
if ! WORKSPACE="$(cd "$WORKSPACE" 2>/dev/null && pwd)"; then
  print_error "Error: directory '${DIR_ARG:-$(pwd)}' does not exist"
  exit 1
fi

ALL_LOG=""
for repo in "$WORKSPACE"/*/; do
  [[ -d "$repo/.git" ]] || continue
  name="$(basename "$repo")"

  main_branch=""
  for b in main master; do
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$b"; then
      main_branch="$b"
      break
    fi
  done
  [[ -z "$main_branch" ]] && continue

  author="$(git -C "$repo" config user.email)"
  log="$(git -C "$repo" log "$main_branch" --since='last monday' --author="$author" --pretty=format:'%h %ad %s' --date=short)"

  if [[ -n "$log" ]]; then
    ALL_LOG+=$'\n## '"$name"$' ('"$main_branch"$')\n'"$log"$'\n'
  fi
done

if [[ -z "$ALL_LOG" ]]; then
  print_info "No activity this week across repositories in $WORKSPACE."
  exit 0
fi

PROMPT="Summarize what I did this week across these repositories. Group by repo. Be concise.
$ALL_LOG"

with_claude_spinner -p "$PROMPT" \
  | print_claude_result
